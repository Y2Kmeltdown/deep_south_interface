                          <parameter>
                            <name>qsf_assignments_list</name>
                            <value># These QSF assignments are provided for your reference.,# Normally you do not need these assignments. The IP will,# make these settings for you. Refer to the user guide for,# scenarios where you might want to override default IP settings.,# Replace your pin names in the pin lists below.,set tx_pin_list { &lt;tx_pin_0&gt; &lt;tx_pin_1&gt; },set rx_pin_list { &lt;rx_pin_0&gt; &lt;rx_pin_1&gt; },# TX pin assignments,foreach tx_pin $tx_pin_list {,set_instance_assignment -name HSSI_PARAMETER "cdr_pll_power_mode=high_perf" -to ${tx_pin},set_instance_assignment -name HSSI_PARAMETER "pma_rx_buf_pm_cr2_rx_path_pma_rx_divclk_hz=500000000" -to ${tx_pin},set_instance_assignment -name HSSI_PARAMETER "pma_rx_buf_power_mode=high_perf" -to ${tx_pin},set_instance_assignment -name HSSI_PARAMETER "pma_rx_buf_pm_cr2_rx_path_power_mode=high_perf" -to ${tx_pin},set_instance_assignment -name HSSI_PARAMETER "pma_rx_buf_pm_cr2_rx_path_power_rail_er=1120" -to ${tx_pin},set_instance_assignment -name HSSI_PARAMETER "pma_rx_buf_sel_vcm_ctle=vocm_eq_fixed" -to ${tx_pin},set_instance_assignment -name HSSI_PARAMETER "pma_rx_buf_vcm_sel=vcm_l0" -to ${tx_pin},set_instance_assignment -name HSSI_PARAMETER "pma_rx_buf_vcm_sel_vccref=6" -to ${tx_pin},set_instance_assignment -name HSSI_PARAMETER "pma_rx_dfe_power_mode=high_perf" -to ${tx_pin},set_instance_assignment -name HSSI_PARAMETER "pma_rx_odi_power_mode=high_perf" -to ${tx_pin},set_instance_assignment -name HSSI_PARAMETER "pma_rx_sd_power_mode=high_perf" -to ${tx_pin},set_instance_assignment -name HSSI_PARAMETER "pma_tx_buf_pm_cr2_tx_path_pma_tx_divclk_hz=500000000" -to ${tx_pin},set_instance_assignment -name HSSI_PARAMETER "pma_tx_buf_pm_cr2_tx_path_power_mode=high_perf" -to ${tx_pin},set_instance_assignment -name HSSI_PARAMETER "pma_tx_buf_pm_cr2_tx_path_power_rail_et=1120" -to ${tx_pin},set_instance_assignment -name HSSI_PARAMETER "pma_tx_buf_uc_vcc_setting=vcc_setting2" -to ${tx_pin},set_instance_assignment -